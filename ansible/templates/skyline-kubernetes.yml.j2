apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: skyline-data
  namespace: {{ mla_skyline_namespace }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ mla_skyline_storage_size }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: skyline
  namespace: {{ mla_skyline_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: skyline
  template:
    metadata:
      labels:
        app.kubernetes.io/name: skyline
      annotations:
        checksum/config: {{ (_skyline_config + _skyline_ca.content) | hash('sha256') }}
    spec:
      automountServiceAccountToken: false
      nodeSelector:
        kubernetes.io/arch: arm64
      initContainers:
        - name: db-sync
          image: {{ mla_skyline_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: KOLLA_BOOTSTRAP
              value: ''
          resources:
{{ mla_skyline_resources | to_nice_yaml(indent=2) | indent(12, true) }}
          volumeMounts: &mounts
            - name: config
              mountPath: /etc/skyline/skyline.yaml
              subPath: skyline.yaml
              readOnly: true
            - name: config
              mountPath: /etc/skyline/mla-ca.crt
              subPath: ca.crt
              readOnly: true
            - name: data
              mountPath: /var/lib/skyline
            - name: logs
              mountPath: /var/log/skyline
      containers:
        - name: skyline
          image: {{ mla_skyline_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: LISTEN_ADDRESS
              value: '0.0.0.0:9999'
          ports:
            - name: http
              containerPort: 9999
          resources:
{{ mla_skyline_resources | to_nice_yaml(indent=2) | indent(12, true) }}
          volumeMounts: *mounts
          startupProbe:
            httpGet:
              path: /api/openstack/skyline/docs
              port: http
            periodSeconds: 10
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /api/openstack/skyline/docs
              port: http
            periodSeconds: 10
      volumes:
        - name: config
          secret:
            secretName: skyline-config
        - name: data
          persistentVolumeClaim:
            claimName: skyline-data
        - name: logs
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: skyline
  namespace: {{ mla_skyline_namespace }}
spec:
  selector:
    app.kubernetes.io/name: skyline
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: skyline
  namespace: {{ mla_skyline_namespace }}
  annotations:
    cert-manager.io/cluster-issuer: {{ atmosphere_ingress_cluster_issuer }}
    nginx.ingress.kubernetes.io/proxy-read-timeout: '300'
    nginx.ingress.kubernetes.io/proxy-body-size: '0'
spec:
  ingressClassName: {{ atmosphere_ingress_class_name }}
  tls:
    - hosts: [{{ mla_skyline_host }}]
      secretName: skyline-tls
  rules:
    - host: {{ mla_skyline_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: skyline
                port:
                  name: http
